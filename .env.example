# YouTube API (Required for video search)
YOUTUBE_API_KEY=your_youtube_api_key_here

# TikTok API (Optional - for auto-upload feature)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_access_token_after_oauth
TIKTOK_REFRESH_TOKEN=your_refresh_token_after_oauth

# YouTube OAuth (Optional - for channel browsing)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# Flask Configuration
FLASK_SECRET_KEY=your_random_secret_key_here
FLASK_DEBUG=False

# Server Configuration (auto-set for Hugging Face)
PORT=7860
