# PRODUCTION Environment Variables

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-change-in-production
FLASK_DEBUG=False

# Server Port (Railway/Hugging Face will override)
PORT=7860

# YouTube Cookies (OPTIONAL - for age-restricted videos)
# To enable: base64 encode your youtube_cookies.txt file
# Linux/Mac: base64 -w 0 youtube_cookies.txt
# Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("youtube_cookies.txt"))
# Then paste the output here:
# YOUTUBE_COOKIES_BASE64=

# yt-dlp Configuration (for cloud deployment)
# IMPORTANT: Keep this FALSE for Railway/Hugging Face
# Setting to true will cause LOGIN_REQUIRED errors on cloud platforms
ENABLE_YOUTUBE_COOKIES=false

# TikTok API (if using auto-upload feature)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# YouTube API (if using search feature)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
